# Copy to .env for a local-only classroom demo. Never use these values in production.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://queueless:queueless_local_only@localhost:5432/queueless?schema=public
JWT_SECRET=replace-with-a-long-random-secret-before-any-non-demo-use
QR_SECRET=replace-with-a-different-long-random-secret-before-any-non-demo-use
# For Android/LAN mode, use your Mac's current IPv4 address, e.g. http://10.252.0.27:5173.
# `npm run dev:lan` supplies that address for the current development process.
PUBLIC_WEB_URL=http://localhost:5173
# The API accepts this URL plus exact localhost development origins. Add a
# comma-separated origin only when a deliberate local proxy requires it.
ALLOWED_ORIGINS=
# Queue sessions are keyed to this operating-day boundary while all timestamps
# continue to be stored as UTC instants in PostgreSQL.
CAMPUS_TIME_ZONE=Asia/Kolkata
COOKIE_SECURE=false
DEMO_MODE=true
# Normal demo tokens get a 15-minute server-enforced check-in window.
DEMO_CHECKIN_WINDOW_MINUTES=15
# Only Admin → Open demo no-show window uses this short timer.
DEMO_NO_SHOW_GRACE_SECONDS=35
# A proof remains valid for 75 seconds while the staff display rotates it every 60 seconds.
QR_ROTATION_SECONDS=60
QR_TTL_SECONDS=75
